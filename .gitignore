##################################
Worklog Specific Ignores
##################################

# Ignore Worklog directory by default
.worklog/*

# Keep config and defaults tracked
!.worklog/config.yaml
!.worklog/config.defaults.yaml
# Private (secret) config — gitignored, never tracked
.worklog/config.private.yaml
# ...but keep the example template tracked
!.worklog/config.private.yaml.example

# Only track plugin config (yaml), not the plugin code itself
!.worklog/plugins/
.worklog/plugins/**/*
!.worklog/plugins/**/
!.worklog/plugins/**/*.yaml

# Agent framework temporary files
.worklog/tmp/

# Local tmux window configuration
scripts/tmux.windows.conf

### End of Worklog Specific Ignores

# Node / package artifacts
node_modules
package.json
bun.lock
.gitignore

# worklog:gitignore:v1
.worklog/initialized
.worklog/worklog.db
.worklog/worklog.db-shm
.worklog/worklog.db-wal
.worklog/worklog-data.jsonl
.worklog/tmp-worktree-*
.worktrees/

__pycache__/
*.pyc

# Guard against reintroduction of the accidental nested skill/skill/ artefact:
# an absolute symlink plus package marker that duplicated skill/shared pytest
# collection and, inside a worktree, resolved to the main checkout's stale copy.
# See LP-0MUHOHP82006NT3W and tests/test_nested_skill_skill_guard.py.
skill/skill/

# Local build artifacts
build/
tmp/

# Local env files
.env
.venv/

# Ralph event signals
.ralph/event.pending

# Ralph config with secrets
.ralph.json

# Implement skill state file (must never be tracked; it would cause
# catastrophic project deletion if _discover_worktree() finds it in
# the repo root instead of a worktree)
.implement_state.json

# Speak skill runtime directory
.pi/speak/

# Test skill run cache (auto-created by the test skill runner)
.test-cache/
.herdr-downtime-disabled
