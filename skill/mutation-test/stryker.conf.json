{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/v10.1.1/packages/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "mutate": [],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 60000,
  "concurrency": 4,
  "incremental": true,
  "incrementalFile": ".stryker-incremental.json",
  "ignoreStatic": true,
  "cleanTempDir": true,
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}
