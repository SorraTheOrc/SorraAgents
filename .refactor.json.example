{
  "_notes": [
    "Scan scope: vendored code and npm-installed packages are excluded from refactor scans by default, at any depth:",
    "  node_modules/, vendor/, third_party/, third-party/, site-packages/, bower_components/, jspm_packages/, packages/",
    "  plus .git/, __pycache__/, build/, dist/, .venv/, venv/, .tox/, .eggs/, *.egg-info/, .worklog/",
    "The project's .gitignore rules are honoured too, even for tracked files (single batched git check-ignore --no-index call).",
    "Includes win: \"include\" entries override the defaults, \"exclude\", and .gitignore for the matched paths.",
    "\"packages/\" is excluded by default (npm-installed); re-include it below if your monorepo keeps its own source there.",
    "Both path keys are optional: omit them to keep the default behaviour."
  ],
  "enabled": true,
  "linter": {
    "enabled": true,
    "severity_overrides": {
      "F841": "low"
    }
  },
  "llm": {
    "enabled": true,
    "model": "default",
    "temperature": 0.1,
    "max_tokens": 2000
  },
  "severity_mapping": {
    "critical": { "priority": "critical", "color": "red" },
    "high": { "priority": "high", "color": "orange" },
    "medium": { "priority": "medium", "color": "yellow" },
    "low": { "priority": "low", "color": "green" }
  },
  "smell_types": [
    "unused_import",
    "unused_variable",
    "unused_function",
    "complex_function",
    "magic_number",
    "duplicate_code",
    "long_method",
    "god_class",
    "feature_envy",
    "inappropriate_intimacy",
    "shotgun_surgery"
  ],
  "exclude": [
    "src/generated",
    "*.min.js"
  ],
  "include": [
    "packages/my-app-package"
  ]
}
